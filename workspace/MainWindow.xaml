<Window x:Class="AIFirst.Workspace.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="AI一手工具箱" Width="1440" Height="960" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackground}" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource InkPrimary}" Closing="OnClosing">
  <Window.Resources>
    <!-- 标题栏图标按钮：无边框，仅 hover 反馈 -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource CaptionInk}" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CaptionHover}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#A82216" /><Setter Property="Foreground" Value="White" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- 顶部导航项：Magpie 式胶囊，选中只加一层卡片底色 -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="ToolTip" Value="{Binding Name}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="NavBg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBg" Property="Background" Value="{DynamicResource SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource InkPrimary}" /></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsSelected" Value="False" /></MultiTrigger.Conditions><Setter TargetName="NavBg" Property="Background" Value="{DynamicResource SurfaceHover}" /><Setter Property="Foreground" Value="{DynamicResource InkSecondary}" /></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="InlineButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="InlineBg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InlineBg" Property="Background" Value="{DynamicResource CaptionHover}" /><Setter Property="Foreground" Value="{DynamicResource InkPrimary}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InlineBg" Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryBg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBg" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryBg" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <!-- 顶栏：品牌在左、导航居中、动作区在右 -->
    <Border Background="{DynamicResource SurfaceCard}" BorderThickness="0">
      <Grid Margin="14,0,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="6" Background="White" VerticalAlignment="Center">
            <Image x:Name="BrandLogo" Stretch="Uniform" AutomationProperties.Name="AI一手 Logo" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <TextBlock x:Name="BrandText" Text="AI一手" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" />
          <Border Width="1" Height="12" Background="{DynamicResource LineStrong}" Margin="9,0" />
          <TextBlock Text="工具箱" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource InkMuted}" />
        </StackPanel>

        <ListBox x:Name="ToolsList" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" SelectionChanged="SelectedToolChanged" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="AI一手工具" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="13" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" Click="ThemeClick" ToolTip="切换深浅色" AutomationProperties.Name="切换深浅色" Width="34" Height="32" Margin="0,0,2,0">
            <Grid Width="16" Height="16">
              <Path x:Name="ThemeMoonPath" Data="M10.6 2.1 A6.2 6.2 0 1 0 13.9 11.4 A5 5 0 0 1 10.6 2.1 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
              <Path x:Name="ThemeSunPath" Data="M8 4.6 A3.4 3.4 0 1 0 8 11.4 A3.4 3.4 0 1 0 8 4.6 Z M8 1 V2.4 M8 13.6 V15 M1 8 H2.4 M13.6 8 H15 M3.2 3.2 L4.2 4.2 M11.8 11.8 L12.8 12.8 M12.8 3.2 L11.8 4.2 M4.2 11.8 L3.2 12.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Visibility="Collapsed" />
            </Grid>
          </Button>

          <Button x:Name="ReleaseNotesButton" Style="{StaticResource InlineButton}" Click="ReleaseNotesClick" Visibility="Collapsed" ToolTip="查看本次更新" AutomationProperties.Name="查看本次更新"><TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center" /></Button>
          <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateClick" FontSize="11.5" Padding="10,4" Margin="4,0,6,0" FocusVisualStyle="{StaticResource KeyboardFocus}" ToolTip="从 AI一手的 GitHub 发布页检查新版本" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
          <Button x:Name="UpdatePillButton" Click="CheckUpdateClick" Visibility="Collapsed" Margin="4,0,6,0" Padding="12,5" FontSize="11.5" Foreground="White" BorderThickness="0" ToolTip="下载并安装新版本" AutomationProperties.Name="更新">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <TextBlock Text="↑ 更新" />
          </Button>

          <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeClick"><Path Data="M1,8 L13,8" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="最大化" AutomationProperties.Name="最大化" Click="MaximizeClick"><Path x:Name="MaximizeGlyph" Data="M1.5,1.5 H12.5 V12.5 H1.5 Z" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
          <Button Style="{StaticResource CloseCaptionButton}" ToolTip="关闭工具箱" AutomationProperties.Name="关闭工具箱" Click="WindowCloseClick"><Path Data="M2,2 L12,12 M12,2 L2,12" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

      <Border Background="{DynamicResource SurfaceCard}" BorderThickness="0">
        <Grid>
          <Grid x:Name="HostSlot" Background="{DynamicResource SurfaceCard}" Visibility="Collapsed" />
          <Grid x:Name="NativeSlot" Visibility="Collapsed" />

          <!-- 启动骨架屏：与真实布局同构，减少跳变 -->
          <Grid x:Name="LoadingView" AutomationProperties.Name="正在准备工具页面" IsHitTestVisible="False" Background="{DynamicResource SurfaceCard}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="18,20">
              <StackPanel>
                <TextBlock Text="已安装的软件" FontSize="11.5" Foreground="{DynamicResource InkFaint}" Margin="0,0,0,12" />
                <Border Background="{DynamicResource Skeleton}" Height="34" CornerRadius="8" Margin="0,0,0,6" />
                <Border Background="{DynamicResource Skeleton}" Height="34" CornerRadius="8" Margin="0,0,0,6" />
                <Border Background="{DynamicResource Skeleton}" Height="34" CornerRadius="8" Margin="0,0,0,6" />
                <Border Background="{DynamicResource Skeleton}" Height="34" CornerRadius="8" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="0,0,0,0">
              <Border Padding="20,18,20,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <StackPanel>
                  <Border Background="{DynamicResource Skeleton}" Height="16" Width="180" CornerRadius="5" HorizontalAlignment="Left" />
                  <Border Background="{DynamicResource Skeleton}" Height="11" Width="300" CornerRadius="4" HorizontalAlignment="Left" Margin="0,9,0,0" />
                </StackPanel>
              </Border>
              <StackPanel Margin="20,14">
                <StackPanel Orientation="Horizontal">
                  <Border Background="{DynamicResource Skeleton}" Height="24" Width="82" CornerRadius="12" Margin="0,0,6,0" />
                  <Border Background="{DynamicResource Skeleton}" Height="24" Width="78" CornerRadius="12" Margin="0,0,6,0" />
                  <Border Background="{DynamicResource Skeleton}" Height="24" Width="78" CornerRadius="12" />
                </StackPanel>
                <Border Background="{DynamicResource Skeleton}" Height="40" CornerRadius="9" Margin="0,16,0,0" Opacity="0.75" />
                <Border Background="{DynamicResource Skeleton}" Height="40" CornerRadius="9" Margin="0,6,0,0" Opacity="0.6" />
                <Border Background="{DynamicResource Skeleton}" Height="40" CornerRadius="9" Margin="0,6,0,0" Opacity="0.45" />
                <TextBlock Text="正在读取本机记录…" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel x:Name="BlankState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <Image x:Name="BlankIcon" Width="46" Height="46" Margin="0,0,0,18" />
            <TextBlock x:Name="BlankTitle" Text="对话搬家" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource InkPrimary}" />
            <TextBlock x:Name="BlankDescription" Text="正在准备，很快就好…" FontSize="13" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,20" LineHeight="22" />
            <Button x:Name="RetryButton" Content="再试一次" Click="RetryClick" HorizontalAlignment="Center" MinWidth="128" MinHeight="36" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="StatusBanner" Grid.Row="1" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="16,10,16,0" Visibility="Collapsed">
        <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource WarnInk}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Border>

      <Border x:Name="UpdateBanner" Grid.Row="2" Background="{DynamicResource InfoSoft}" BorderBrush="{DynamicResource InfoLine}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="16,10,16,14" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock x:Name="UpdateTitle" Text="发现新版本" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InfoInk}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="UpdateDescription" Text="新工具会一起更新，不用重新添加。" FontSize="11.5" Foreground="{DynamicResource InkSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
            <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="3" Margin="0,9,0,0" AutomationProperties.Name="更新下载进度" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="DismissUpdateButton" Content="稍后" Click="DismissUpdateClick" Style="{StaticResource InlineButton}" Margin="0,0,6,0" />
            <Button x:Name="InstallUpdateButton" Content="下载并更新" Click="InstallUpdateClick" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
