<Window x:Class="AIFirst.Workspace.ResetNoticeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 重置消息" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceCard}" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource InkPrimary}" ShowInTaskbar="True" UseLayoutRounding="True" Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="NoticeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Padding" Value="14,8" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24,20,24,22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="9" Background="White" VerticalAlignment="Top" Padding="3">
          <Image x:Name="NoticeLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Codex" />
        </Border>
        <StackPanel Grid.Column="1" Margin="11,0,0,0">
          <TextBlock x:Name="NoticeHeading" Text="Codex 有重置消息" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
          <TextBlock x:Name="NoticePublished" Foreground="{DynamicResource InkFaint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>

      <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="15,13" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock x:Name="NoticeSummary" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource InkPrimary}" />
          <TextBlock x:Name="NoticeTime" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" LineHeight="23" Margin="0,9,0,0" />
          <TextBlock x:Name="NoticeExcerpt" Foreground="{DynamicResource InkMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" />
          <Button x:Name="OriginalPostButton" Content="查看原帖 ↗" Click="OpenOriginalClick" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" BorderThickness="0" Background="Transparent" Padding="0,7" MinHeight="30" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="NoticeGuidance" Text="想等这次重置又保留卡，关闭自动用卡即可。自动续跑可以继续开启，额度到账后接着做。" Foreground="{DynamicResource InkMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0" />

      <Border x:Name="NoticeResultCard" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="9" Padding="12,9" Visibility="Collapsed" Margin="0,13,0,0">
        <TextBlock x:Name="NoticeResultText" Foreground="{DynamicResource WarnInk}" TextWrapping="Wrap" LineHeight="20" FontSize="12" AutomationProperties.LiveSetting="Polite" />
      </Border>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button x:Name="PauseButton" Content="关闭用卡，等重置" Style="{StaticResource NoticeButton}" Click="PauseClick" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderBrush="{DynamicResource Accent}" />
        <Button x:Name="DismissButton" Grid.Column="2" Content="知道了" Style="{StaticResource NoticeButton}" Click="DismissClick" IsCancel="True" IsDefault="True" MinWidth="80" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
