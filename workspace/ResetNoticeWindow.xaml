<Window x:Class="AIFirst.Workspace.ResetNoticeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 重置消息" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#202D3A" ShowInTaskbar="True" UseLayoutRounding="True" Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="NoticeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="44" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="16,11" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" /></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="28,24,28,26">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="12" Background="#F7F9FC" VerticalAlignment="Top"><Image x:Name="NoticeLogo" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Codex" /></Border><StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock x:Name="NoticeHeading" Text="Codex 有重置消息" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="NoticePublished" Foreground="#5B6B7E" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Grid>
      <Border Background="#F7F9FC" BorderBrush="#E5EAF1" BorderThickness="1" CornerRadius="12" Padding="17,15" Margin="0,22,0,0"><StackPanel><TextBlock x:Name="NoticeSummary" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" LineHeight="24" /><TextBlock x:Name="NoticeTime" FontSize="17" FontWeight="SemiBold" Foreground="#145C9C" TextWrapping="Wrap" LineHeight="27" Margin="0,12,0,0" /><TextBlock x:Name="NoticeExcerpt" Foreground="#5B6B7E" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0" /><Button x:Name="OriginalPostButton" Content="查看原帖 ↗" Click="OpenOriginalClick" HorizontalAlignment="Left" Foreground="#0068D9" BorderThickness="0" Background="Transparent" Padding="0,9" MinHeight="40" FontSize="13" Margin="0,5,0,0" /></StackPanel></Border>
      <TextBlock x:Name="NoticeGuidance" Text="想等这次重置、保留还没使用的卡，可以先关闭续跑。准备好后再手动开启。" Foreground="#5B6B7E" TextWrapping="Wrap" LineHeight="24" Margin="0,20,0,0" />
      <Border x:Name="NoticeResultCard" Background="#FFF5E4" CornerRadius="9" Padding="13,11" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock x:Name="NoticeResultText" Foreground="#8A5A1E" TextWrapping="Wrap" LineHeight="22" FontSize="13" AutomationProperties.LiveSetting="Polite" /></Border>
      <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="PauseButton" Content="先关续跑，等重置" Style="{StaticResource NoticeButton}" Click="PauseClick" Background="#0073E6" Foreground="White" BorderBrush="#0073E6" /><Button x:Name="DismissButton" Grid.Column="2" Content="知道了" Style="{StaticResource NoticeButton}" Click="DismissClick" IsCancel="True" IsDefault="True" MinWidth="88" /></Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
