<UserControl x:Class="AIFirst.Workspace.AutoResumePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Width" Value="54" /><Setter Property="Height" Value="30" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Grid><Border x:Name="Track" Background="#CBD2DB" CornerRadius="15" /><Ellipse x:Name="Thumb" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="4" /></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#0073E6" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="840" Margin="36,32" HorizontalAlignment="Stretch">
      <TextBlock Text="Codex 自动续跑" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="额度用完后等待，恢复后在原来的对话里继续。" Foreground="#687686" Margin="0,10,0,28" TextWrapping="Wrap" />
      <Border x:Name="StateCard" Background="#F3F7FC" CornerRadius="10" Padding="22,20" Margin="0,0,0,28">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0"><TextBlock x:Name="StateTitle" Text="正在读取运行状态…" FontSize="19" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="StateDescription" Text="正在连接电脑上已有的续跑程序。" Foreground="#687686" TextWrapping="Wrap" LineHeight="23" Margin="0,7,0,0" /></StackPanel>
          <Button x:Name="RefreshButton" Content="刷新状态" Click="RefreshClick" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Padding="14,9" />
        </Grid>
      </Border>
      <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="自动续跑" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="关闭时同时取消开机自启。只控制续跑程序，不会关闭 Codex。" Foreground="#687686" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" /></StackPanel>
        <ToggleButton x:Name="RunningSwitch" Style="{StaticResource Switch}" Click="RunningClick" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="自动续跑开关" />
      </Grid>
      <Border Height="1" Background="#E8ECF1" Margin="0,0,0,24" />
      <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="开机自动开启" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="登录电脑后自动运行。关闭这一项，只影响下次开机。" Foreground="#687686" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" /></StackPanel>
        <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="AutostartClick" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="开机自动开启开关" />
      </Grid>
      <Border x:Name="MessageCard" Background="#FFF6E8" CornerRadius="8" Padding="14,12" Visibility="Collapsed" Margin="0,0,0,24"><TextBlock x:Name="MessageText" Foreground="#836337" TextWrapping="Wrap" LineHeight="23" AutomationProperties.LiveSetting="Polite" /></Border>
      <Border Background="#F8FAFC" CornerRadius="9" Padding="20,16">
        <StackPanel><TextBlock Text="关掉工作台，后台仍会运行" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="想停止自动续跑，请关闭上面的开关。再次开启时会继续使用现有配置，不需要打开命令行。" FontSize="13" Foreground="#687686" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="23" /></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
