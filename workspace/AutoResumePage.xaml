<UserControl x:Class="AIFirst.Workspace.AutoResumePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIFirst.Workspace" Background="#F7F9FC" FontFamily="Microsoft YaHei UI" Foreground="#202D3A" UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ResumeMuted" Color="#5B6B7E" />
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Width" Value="56" /><Setter Property="Height" Value="44" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Grid Background="Transparent"><Border x:Name="Track" Height="32" Background="#7B899B" CornerRadius="16" /><Ellipse x:Name="Thumb" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0" /></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#0073E6" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.7" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="13,8" /><Setter Property="BorderBrush" Value="#DFE6EF" /><Setter Property="Background" Value="White" /></Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Foreground" Value="#0068D9" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,8" /></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="PageContent" MaxWidth="900" Margin="32,30,32,32" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Width="58" Height="58" CornerRadius="16" Background="White" BorderBrush="#DFE6EF" BorderThickness="1" VerticalAlignment="Top"><Image x:Name="CodexLogo" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Codex" /></Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="续跑与重置" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Codex 额度恢复后接着做，重置消息及时提醒你。" FontSize="14" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
      </Grid>
      <Border x:Name="StateCard" Background="White" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="16" Padding="26,22" Margin="0,0,0,20">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="自动续跑" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /><Border x:Name="StateBadge" Background="#EEF2F7" CornerRadius="6" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="StateTitle" Text="正在确认状态…" Foreground="#5B6B7E" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" /></Border></StackPanel>
            <Button x:Name="RefreshButton" Content="刷新状态" Style="{StaticResource QuietButton}" Click="RefreshClick" Grid.Column="1" Margin="0,0,14,0" />
            <ToggleButton x:Name="RunningSwitch" Style="{StaticResource Switch}" Click="RunningClick" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="自动续跑开关" />
          </Grid>
          <TextBlock x:Name="StateDescription" Text="请稍等。" FontSize="13" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" LineHeight="22" Margin="0,9,0,0" />
          <TextBlock Text="关掉窗口也有效，关闭开关才会停止续跑。" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" Margin="0,7,0,0" />
          <Border Background="#F7F9FC" CornerRadius="10" Padding="16,12" Margin="0,18,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="周额度用完时自动使用重置卡" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="关闭后只等额度恢复，到账后仍会自动续跑。" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
              <ToggleButton x:Name="CreditSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="CreditClick" IsEnabled="False" AutomationProperties.Name="周额度用完时自动使用重置卡" />
            </Grid>
          </Border>
          <Border x:Name="MessageCard" Background="#FFF5E4" CornerRadius="9" Padding="13,11" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock x:Name="MessageText" Foreground="#8A5A1E" FontSize="13" TextWrapping="Wrap" LineHeight="22" AutomationProperties.LiveSetting="Polite" /></Border>
          <Border Height="1" Background="#E9EDF3" Margin="0,16,0,12" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="自动开启 5 小时计时" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="额度可用且没有任务续跑时，用轻量模型发一次极短请求。会消耗少量额度，不使用重置卡。" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" /><TextBlock Text="独立于续跑开关；开启后，关闭续跑仍会执行这次请求。" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock x:Name="TimerDescription" Text="默认关闭，开启后自动检查。" FontSize="12" Foreground="#0068D9" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite" /></StackPanel><ToggleButton x:Name="TimerSwitch" Style="{StaticResource Switch}" Click="TimerClick" Grid.Column="1" VerticalAlignment="Top" IsEnabled="False" AutomationProperties.Name="自动开启5小时计时" /></Grid>
          <Border Height="1" Background="#E9EDF3" Margin="0,18,0,14" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="登录后自动运行" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="下次登录电脑时，继续运行上面已开启的功能。" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel><ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="AutostartClick" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="登录后自动运行开关" /></Grid>
        </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="16" Padding="26,22">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="重置日历" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="关注 Tibo 的重置消息，关掉窗口也会提醒。" FontSize="13" Foreground="{StaticResource ResumeMuted}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="提醒" FontSize="12" Foreground="{StaticResource ResumeMuted}" VerticalAlignment="Center" Margin="0,0,10,0" /><ToggleButton x:Name="ResetEnabledSwitch" Style="{StaticResource Switch}" Click="ResetEnabledClick" IsEnabled="False" AutomationProperties.Name="重置消息提醒开关" /></StackPanel></Grid>
          <Border x:Name="ResetStatusCard" Background="#F7F9FC" CornerRadius="9" Padding="12,9" Margin="0,20,0,0"><StackPanel><TextBlock x:Name="ResetStatusText" Text="重置提醒尚未开启" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="ResetDetailText" Text="开启后，有重置相关消息时会提醒你。" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0" /></StackPanel></Border>
          <local:ResetCalendarView x:Name="ResetCalendar" Margin="0,24,0,0" />
          <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ResetCheckedText" Text="尚未检查" FontSize="12" Foreground="{StaticResource ResumeMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" /><Button x:Name="ResetRefreshButton" Grid.Column="1" Content="刷新" Style="{StaticResource QuietButton}" Click="ResetRefreshClick" IsEnabled="False" /></Grid>
        </StackPanel>
      </Border>
      <TextBlock Text="想等官方重置又保留卡，关闭“自动使用重置卡”即可，自动续跑可以继续开启。电脑关机或休眠期间无法执行。" Foreground="{StaticResource ResumeMuted}" FontSize="13" TextWrapping="Wrap" Margin="4,18,4,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
