<UserControl x:Class="AIFirst.Workspace.AutoResumePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIFirst.Workspace" Background="Transparent" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource InkPrimary}" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Width" Value="46" /><Setter Property="Height" Value="30" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Grid Background="Transparent">
          <Border x:Name="Track" Width="40" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource LineStrong}" CornerRadius="11" />
          <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.7" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" /><Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,8" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="PageContent" MaxWidth="840" Margin="26,24,26,30" HorizontalAlignment="Stretch">

      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Top">
          <Image x:Name="CodexLogo" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Codex" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="续跑与重置" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
          <TextBlock Text="Codex 额度恢复后接着做，重置消息及时提醒你。" FontSize="12.5" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>

      <StackPanel x:Name="StateCard">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="自动续跑" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource InkPrimary}" />
            <Border x:Name="StateBadge" Background="{DynamicResource BadgeNeutralBg}" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="StateTitle" Text="正在确认状态…" Foreground="{DynamicResource BadgeNeutralInk}" FontSize="11.5" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
            </Border>
          </StackPanel>
          <Button x:Name="RefreshButton" Content="刷新状态" Style="{StaticResource QuietButton}" Click="RefreshClick" Grid.Column="1" Margin="0,0,10,0" />
          <ToggleButton x:Name="RunningSwitch" Style="{StaticResource Switch}" Click="RunningClick" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="自动续跑开关" />
        </Grid>
        <TextBlock x:Name="StateDescription" Text="请稍等。" FontSize="12.5" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0" />
        <TextBlock Text="关掉窗口也有效，关闭开关才会停止续跑。" FontSize="11.5" Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap" Margin="0,5,0,0" />

        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="9" Padding="14,11" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="周额度用完时自动使用重置卡" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
              <TextBlock x:Name="CreditDescription" Text="开启续跑后可设置；关闭续跑会同时关闭用卡。" FontSize="11.5" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <ToggleButton x:Name="CreditSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="CreditClick" IsEnabled="False" AutomationProperties.Name="周额度用完时自动使用重置卡" />
          </Grid>
        </Border>

        <Border x:Name="MessageCard" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="9" Padding="12,9" Visibility="Collapsed" Margin="0,14,0,0">
          <TextBlock x:Name="MessageText" Foreground="{DynamicResource WarnInk}" FontSize="12" TextWrapping="Wrap" LineHeight="20" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,14" />

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,18,0">
            <TextBlock Text="自动开启 5 小时计时" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
            <TextBlock Text="额度可用且没有任务续跑时，用轻量模型发一次极短请求。会消耗少量额度，不使用重置卡。" FontSize="11.5" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
            <TextBlock Text="独立于续跑开关；开启后，关闭续跑仍会执行这次请求。" FontSize="11.5" Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="TimerDescription" Text="默认关闭，开启后自动检查。" FontSize="11.5" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ToggleButton x:Name="TimerSwitch" Style="{StaticResource Switch}" Click="TimerClick" Grid.Column="1" VerticalAlignment="Top" IsEnabled="False" AutomationProperties.Name="自动开启5小时计时" />
        </Grid>

        <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,14" />

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,18,0">
            <TextBlock Text="登录后自动运行" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
            <TextBlock x:Name="AutostartDescription" Text="下次登录电脑时，继续运行上面已开启的功能。" FontSize="11.5" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="AutostartClick" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="登录后自动运行开关" />
        </Grid>
      </StackPanel>

      <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,18" />

      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,18,0">
            <TextBlock Text="重置日历" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
            <TextBlock Text="关注 Tibo 的重置消息，关掉窗口也会提醒。" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="提醒" FontSize="11.5" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton x:Name="ResetEnabledSwitch" Style="{StaticResource Switch}" Click="ResetEnabledClick" IsEnabled="False" AutomationProperties.Name="重置消息提醒开关" />
          </StackPanel>
        </Grid>

        <Border x:Name="ResetStatusCard" Background="{DynamicResource SurfaceRaised}" CornerRadius="9" Padding="12,9" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock x:Name="ResetStatusText" Text="重置提醒尚未开启" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ResetDetailText" Text="开启后，有重置相关消息时会提醒你。" FontSize="11.5" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <local:ResetCalendarView x:Name="ResetCalendar" Margin="0,20,0,0" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="ResetCheckedText" Text="尚未检查" FontSize="11.5" Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button x:Name="ResetRefreshButton" Grid.Column="1" Content="刷新" Style="{StaticResource QuietButton}" Click="ResetRefreshClick" IsEnabled="False" />
        </Grid>
      </StackPanel>

      <TextBlock Text="想等官方重置又保留卡，关闭“自动使用重置卡”即可，自动续跑可以继续开启。电脑关机或休眠期间无法执行。" Foreground="{DynamicResource InkFaint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="19" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
