<Window x:Class="AIFirst.Workspace.WhatsNewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="本次更新 · AI一手工具箱" Width="536" SizeToContent="Height" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="{DynamicResource InkPrimary}" UseLayoutRounding="True"
 PreviewKeyDown="DialogKeyDown">
 <Border Margin="16" Padding="26,22,26,22" Background="{DynamicResource SurfaceCard}" CornerRadius="14" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
  <Grid KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="40" Height="40" CornerRadius="10" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="3"><Image x:Name="BrandImage" Stretch="Uniform" /></Border>
    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="本次更新" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource InkMuted}"/><TextBlock x:Name="ReleaseVersion" Foreground="{DynamicResource InkPrimary}" FontSize="13" Margin="0,2,0,0"/></StackPanel>
    <Button Grid.Column="2" x:Name="CloseButton" Width="30" Height="30" Padding="0" Background="Transparent" Foreground="{DynamicResource CaptionInk}" BorderThickness="0" VerticalAlignment="Top" Click="DismissClick" ToolTip="关闭" AutomationProperties.Name="关闭更新说明"><Path Data="M1,1 L11,11 M11,1 L1,11" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/></Button>
   </Grid>

   <StackPanel Grid.Row="1" Margin="0,0,0,22"><TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="27" Foreground="{DynamicResource InkPrimary}"/><TextBlock x:Name="Description" Foreground="{DynamicResource InkMuted}" FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20"/></StackPanel>

   <ScrollViewer Grid.Row="2" x:Name="HighlightsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
    <ItemsControl x:Name="HighlightsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Top"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Accent}" FontSize="10.5" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource InkPrimary}"/></Grid>
     <TextBlock Text="{Binding Text}" Foreground="{DynamicResource InkSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>

   <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,2,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="FullNotesButton" Content="完整更新说明 ↗" HorizontalAlignment="Left" Padding="0,7" Background="Transparent" Foreground="{DynamicResource InkMuted}" BorderThickness="0" Click="FullNotesClick" FontSize="11.5" AutomationProperties.Name="在浏览器查看完整更新说明"/>
    <Button Grid.Column="1" x:Name="DismissButton" Content="知道了" MinWidth="104" MinHeight="34" Padding="18,8" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" FontWeight="SemiBold" FontSize="12.5" IsDefault="True" Click="DismissClick"/>
   </Grid></Border>

  </Grid>
 </Border>
</Window>
